# ==============================================================================
# DÉPANNE-MOI — variables d'environnement
# Copier en `.env` puis renseigner. Ne JAMAIS committer le `.env`.
# ==============================================================================

APP_NAME="Dépanne-Moi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Conakry est en UTC+0. Les dates sont stockées en UTC et affichées dans ce fuseau.
APP_TIMEZONE=Africa/Conakry
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

# ------------------------------------------------------------------ sécurité --
# argon2id est imposé pour les mots de passe (§4). bcrypt n'est conservé que
# comme repli si l'extension sodium venait à manquer.
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4

# ------------------------------------------------------------------ journaux --
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# BASE DE DONNÉES
# ------------------------------------------------------------------------------
# Deux connexions distinctes (ADR-0006) :
#   `pgsql`           — utilisée par l'application. En production Supabase, elle
#                       pointe sur le pooler (port 6543, mode transaction), qui
#                       ne supporte pas les instructions préparées nommées.
#   `pgsql_migrations`— utilisée uniquement par `artisan migrate`. En production
#                       Supabase, connexion directe (port 5432).
# En local, les deux pointent sur le même cluster PostgreSQL 17 + PostGIS.
# ==============================================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=depanne_moi
DB_USERNAME=depanne
DB_PASSWORD=
DB_SSLMODE=prefer

# Désactive les instructions préparées nommées (obligatoire derrière le pooler
# Supabase en mode transaction, sans effet notable en local).
DB_DISABLE_NATIVE_PREPARES=false

# Connexion de migration — laisser vide en local pour réutiliser la connexion
# applicative ; renseigner en production Supabase (port 5432, connexion directe).
DB_MIGRATIONS_HOST=
DB_MIGRATIONS_PORT=
DB_MIGRATIONS_DATABASE=
DB_MIGRATIONS_USERNAME=
DB_MIGRATIONS_PASSWORD=

# Base utilisée par la suite de tests (Pest).
DB_TEST_DATABASE=depanne_moi_test

# ==============================================================================
# SUPABASE — à renseigner lors de la bascule (phase A1bis)
# La clé `service_role` ne doit JAMAIS quitter le serveur (jamais dans Flutter).
# ==============================================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage Supabase, exposé en S3 via le driver Flysystem.
# Buckets : identity-docs (privé), intervention-photos (privé), avatars (public).
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# ==============================================================================
# FILES D'ATTENTE, CACHE, SESSION
# ------------------------------------------------------------------------------
# En local (sans Docker ni Redis) : tout passe par PostgreSQL. Le pilote
# `database` de Laravel fournit des verrous atomiques, donc `Cache::lock()` —
# indispensable au matching (ADR-0008) — fonctionne à l'identique.
# En production : basculer les trois sur `redis` et activer Horizon.
# ==============================================================================
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================================
# TEMPS RÉEL — Laravel Reverb (WebSocket)
# ==============================================================================
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=depanne
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ==============================================================================
# FOURNISSEURS EXTERNES
# Chacun est derrière une interface (ADR-0005). Le pilote `mock` / `log` permet
# de développer et de tester sans aucun compte tiers.
# ==============================================================================

# --- Cartographie ------------------------------------------------------------
# google    : Distance Matrix + Directions (facturé, clé serveur restreinte par IP)
# haversine : distance à vol d'oiseau × 1,3 — repli automatique si Google échoue
MAP_PROVIDER=haversine
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
GOOGLE_MAPS_JS_KEY=
# Durée de mise en cache des distances routières (secondes).
MAP_DISTANCE_CACHE_TTL=604800

# --- Paiement Mobile Money ---------------------------------------------------
# mock         : simule le parcours complet, webhook déclenchable en local
# orange_money : Orange Money Guinée (fournisseur retenu pour le pilote)
# Origines autorisées à appeler l'API depuis un navigateur, séparées par des
# virgules. L'application Flutter n'est pas concernée : un client natif
# n'envoie pas d'en-tête Origin.
CORS_ALLOWED_ORIGINS=http://localhost:8000

PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=GNF
ORANGE_MONEY_BASE_URL=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_WEBHOOK_SECRET=
# Réservé : MTN MoMo, Wave... branchés plus tard derrière la même interface.
MTN_MOMO_BASE_URL=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=

# --- Notifications push ------------------------------------------------------
# log      : écrit la notification dans laravel.log et la diffuse via Reverb
# database : ajoute l'entrée dans la table `notifications`
# fcm      : Firebase Cloud Messaging (production)
PUSH_PROVIDER=log
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# --- SMS (uniquement pour le code de réinitialisation de mot de passe) --------
# log : le code à 6 chiffres est écrit dans laravel.log
SMS_PROVIDER=log
SMS_SENDER_ID="DepanneMoi"
SMS_API_URL=
SMS_API_KEY=

# --- Appel à numéro masqué ---------------------------------------------------
MASKED_CALL_PROVIDER=mock

# ==============================================================================
# MESSAGERIE
# ==============================================================================
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@depanne-moi.gn"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
